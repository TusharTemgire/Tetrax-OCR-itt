[Unit]
Description=Tetrax OCR API
After=network.target

[Service]
User=tetraxocr
Group=www-data
WorkingDirectory=/opt/tetrax-ocr
Environment="PYTHONUNBUFFERED=1"
Environment="TETRAX_MAX_UPLOAD_BYTES=15728640"
Environment="TETRAX_MAX_PDF_PAGES=30"
ExecStart=/opt/tetrax-ocr/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000 --workers 1
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
